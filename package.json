{
  "name": "personal-ai-anki-builder",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop app that generates Anki cards following a personal learning methodology.",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "echo 'No linter configured yet'"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "electron-log": "^5.1.5",
    "openai": "^4.62.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.4.0",
    "electron-vite": "^2.3.0",
    "tsx": "^4.22.4",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
