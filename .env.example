# OpenAI API key (required)
OPENAI_API_KEY=sk-...

# AnkiConnect endpoint (default is fine for local Anki with the AnkiConnect plugin)
ANKI_CONNECT_URL=http://127.0.0.1:8765

# OpenAI chat model used to generate card content (IPA, meaning, example, cloze)
OPENAI_MODEL=gpt-4o

# OpenAI TTS voice: alloy | echo | fable | onyx | nova | shimmer
OPENAI_TTS_VOICE=nova

# OpenAI TTS model: tts-1 | gpt-4o-mini-tts
OPENAI_TTS_MODEL=tts-1

# Anki deck target name (must already exist in Anki)
ANKI_DECK_NAME=English Automatic

# Anki note type / model name (must already exist in Anki)
ANKI_MODEL_NAME=English Automatic

# Optional: absolute path to a CardBuilder prompt override file. If unset, defaults to docs/card-philosophy.md + docs/style-guide.md.
PROMPT_FILE_PATH=
